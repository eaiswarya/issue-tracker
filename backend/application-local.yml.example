# Copy to backend/application-local.yml (git-ignored) and adjust for your machine.
# If another PostgreSQL already uses port 5432, start the container with
# DB_PORT=5433 docker compose up -d db and set the same port below.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/issuetracker
    username: issuetracker
    password: issuetracker
